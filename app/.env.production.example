# Template de variaveis de ambiente de PRODUCAO para o App_Web (Expo export
# --platform web). Copie este arquivo para `.env` antes de rodar
# `npx expo export --platform web` na VM_Producao.
#
# IMPORTANTE: as variaveis EXPO_PUBLIC_* sao embutidas no bundle JS no
# MOMENTO DO BUILD. Trocar o .env depois de gerar o build nao tem efeito;
# e necessario gerar um novo build (`npx expo export --platform web`) para
# que qualquer alteracao aqui passe a valer.

# URL absoluta da API. O App_Web roda no navegador do cliente (fora da rede
# interna da VM_Producao), entao precisa da URL publica completa com o
# prefixo /api usado pelo Nginx_Existente para rotear ate o container da API.
EXPO_PUBLIC_API_BASE_URL=https://appsalao.abrasel.xyz/api

# Mesma chave configurada em APP_API_KEY na API (api/.env.production).
# Use um valor de producao, diferente do usado em desenvolvimento local.
EXPO_PUBLIC_API_KEY=valor-de-producao-diferente-do-dev