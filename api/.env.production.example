# Template de variáveis de ambiente de PRODUÇÃO. Nunca commitar o
# .env.production real (copie este arquivo e preencha com valores reais).
#
# IMPORTANTE: todos os valores abaixo devem ser DIFERENTES dos valores usados
# em desenvolvimento local (api/.env). Nunca reutilize senhas, segredos ou
# chaves de dev em produção.

# PostgreSQL connection string do Banco_De_Producao (banco e usuário
# dedicados na instância PostgreSQL já existente na VM_Producao, distintos
# dos usados em dev/outras aplicações).
DATABASE_URL="postgresql://salao_abrasel_prod:SENHA_FORTE@localhost:5432/salao_abrasel_prod?schema=public"

# Porta HTTP interna da API dentro do container. Publicada apenas em
# 127.0.0.1 (nunca 0.0.0.0) e usada pelo Nginx_Existente como proxy_pass.
PORT=3333

# Chave que o app mobile envia no header "x-api-key" em toda requisição.
# Gere um valor novo e aleatório para produção (não reutilizar o de dev).
APP_API_KEY="valor-de-producao-diferente-do-dev"

# Chave administrativa. Deve ser preenchida por conformidade com os
# requisitos de variáveis de ambiente de produção, mesmo que hoje
# `api/src/env.ts` NÃO declare nem valide ADMIN_API_KEY no envSchema
# (apenas DATABASE_URL, PORT, APP_API_KEY e JWT_SECRET são validadas).
# Ou seja: definir esta variável aqui não tem efeito no código atual — não
# é erro de deploy, mas uma lacuna documentada para uma spec futura de
# código, caso a autenticação administrativa venha a depender dela.
ADMIN_API_KEY="valor-de-producao-diferente-do-dev"

# Segredo usado para assinar os tokens JWT de login (mín. 16 caracteres).
# Gere um valor aleatório e longo, distinto do usado em dev.
JWT_SECRET="segredo-jwt-de-producao-longo-e-aleatorio"

# O "esqueci minha senha" do app é uma troca direta (e-mail + nova senha),
# feita inteiramente dentro do aplicativo: não manda e-mail, não usa serviço
# externo e não precisa de variável de ambiente.
