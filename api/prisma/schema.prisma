generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Event {
  id             String   @id @default(uuid())
  title          String
  description    String   @db.Text
  speaker        String?
  locationName   String   @map("location_name")
  locationMapX   Float?   @map("location_map_x")
  locationMapY   Float?   @map("location_map_y")
  startTime      DateTime @map("start_time")
  endTime        DateTime @map("end_time")
  category       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  favorites     UserFavorite[]
  notifications Notification[]

  @@index([startTime])
  @@index([category])
  @@map("events")
}

// Dois níveis, só: quem usa o app e quem administra o evento. O papel mora
// no banco (e não num token ou numa lista de e-mails no .env) pra que revogar
// um admin tenha efeito imediato — o middleware relê o papel a cada requisição
// em vez de confiar no que estava assinado no JWT.
enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")

  favorites     UserFavorite[]
  notifications Notification[]

  @@map("users")
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@map("user_favorites")
}

// Notificação in-app. Esta tabela acumula os dois papéis que antes eram
// separados: é o REGISTRO que o usuário vê no sininho e, ao mesmo tempo, o
// livro-caixa que impede aviso repetido — o unique abaixo é o que garante
// que a varredura de 1 em 1 minuto nunca crie a mesma notificação duas
// vezes (o create falha e a varredura segue em frente).
//
// `minutesBefore` guarda QUAL aviso é (1 dia / 1 hora / 15 min antes), e é
// justamente por fazer parte da chave única que o mesmo evento pode gerar
// os três avisos sem que nenhum deles se repita.
model Notification {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  eventId       String    @map("event_id")
  type          String    @default("event_reminder")
  minutesBefore Int       @map("minutes_before")
  title         String
  message       String    @db.Text
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, minutesBefore])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
