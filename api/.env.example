# PostgreSQL connection string (Railway ou local). Nunca commitar o .env real.
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Porta HTTP da API (Railway injeta PORT automaticamente em produção)
PORT=3333

# Chave que o app mobile envia no header "x-api-key" em toda requisição
APP_API_KEY="troque-esta-chave-do-app"

# As rotas administrativas (CRUD de eventos e gestão de usuários) NÃO usam
# chave compartilhada: exigem login de uma conta com papel ADMIN. Para criar
# ou promover a primeira:
#   ADMIN_EMAIL=voce@exemplo.com ADMIN_PASSWORD="senha-forte" npm run admin:create

# Segredo usado para assinar os tokens JWT de login (mín. 16 caracteres, gere um valor aleatório)
JWT_SECRET="troque-este-segredo-jwt-por-um-valor-aleatorio-longo"

# Os lembretes de palestras favoritadas são notificações in-app (tabela
# `notifications`, exibidas no sininho do app) — não dependem de nenhum
# serviço externo nem de chave adicional.

# --- Recuperação de senha por e-mail (opcional) ---
# Sem RESEND_API_KEY a API sobe igual e o "esqueci minha senha" responde que
# não está disponível, em vez de prometer um e-mail que nunca sai.
#
# A chave vem de resend.com. Para enviar a QUALQUER destinatário é preciso um
# domínio verificado lá; com o remetente de testes "onboarding@resend.dev" só
# chega no e-mail dono da conta do Resend.
RESEND_API_KEY=""
EMAIL_FROM="Salão Abrasel <onboarding@resend.dev>"

# Base dos links do e-mail — o endereço onde o app está publicado. O link vai
# como "<APP_PUBLIC_URL>/?reset=<token>".
APP_PUBLIC_URL="https://appsalao.abrasel.xyz"
